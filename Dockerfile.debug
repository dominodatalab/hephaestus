# hadolint global ignore=DL3018
FROM --platform=$BUILDPLATFORM golang:1.26.10-alpine AS build
ARG VERSION="dev"
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY pkg ./pkg
COPY deployments/crds ./deployments/crds
# Cross-compile natively using Go's built-in support (no QEMU emulation needed)
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-X 'main.Version=${VERSION}'" -o hephaestus-controller ./cmd/controller


FROM cgr.dev/chainguard/wolfi-base:latest@sha256:b7787f1d3f29dcfb48730372d3515391ac3b218723201a765c94949922676099
ARG USERNAME=lala
ARG USER_UID=1001
ARG USER_GID=$USER_UID
USER root
RUN apk add --no-cache \
    7zip \
    bash \
    bind-tools \
    coreutils \
    curl \
    glibc-locales \
    gnupg \
    gpg \
    grep \
    httpie \
    iputils \
    jq \
    kafkacat \
    mysql-client \
    nano \
    net-tools \
    netcat-openbsd \
    ngrep \
    openssh-client \
    postgresql-client \
    py3-pip \
    shadow \
    swaks \
    tcpdump \
    valkey-9.0-cli \
    vim \
    wget \
    xz \
  && ln -s /usr/bin/valkey-cli /usr/bin/redis-cli \
  && ln -s /usr/bin/kcat /usr/bin/kafkacat \
  && { [ -e /usr/bin/python3 ] || ln -s "$(ls /usr/bin/python3.* | grep -E '/python3\.[0-9]+$' | sort -V | tail -1)" /usr/bin/python3; } \
  && groupadd --gid $USER_GID $USERNAME \
  && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
  && mkdir -p /opt


WORKDIR /
COPY . /src
COPY --from=build /app/hephaestus-controller /usr/bin/
RUN chown -R 1001:1001 /src /opt && chown -R 1001:1001 /usr/bin/hephaestus-controller
USER lala

ENTRYPOINT ["/usr/bin/hephaestus-controller"]
